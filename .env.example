# Environment Variables Example for AI-Assisted Telemedicine Kiosk

# Flask Application & Security
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
PORT=5000

# Database Configuration (Defaults to SQLite; use MySQL URL for production / AWS RDS)
# SQLite default:
DATABASE_URL=sqlite:///telemedicine.db
# MySQL / AWS RDS example:
# DATABASE_URL=mysql+pymysql://telemed_user:your_password@telemed-db.cluster-xxx.ap-south-1.rds.amazonaws.com:3306/telemedicine_db

# OpenAI API Key (Required for Whisper Speech-to-Text & OpenAI TTS Voice Prompts)
OPENAI_API_KEY=your-openai-api-key-here

# WebRTC STUN / TURN Configuration
STUN_SERVER=stun:stun.l.google.com:19302
# TURN_SERVER=turn:turn.example.com:3478
# TURN_USERNAME=telemed_turn
# TURN_PASSWORD=turn_secret_key

# CORS Allowed Origins
CORS_ORIGINS=*
